
#include <bits/stdc++.h>
using namespace std;

int main() {
    int N, M;
    cin >> N >> M;

    vector<pair<int, int>> a(M);

    for (int i = 0; i < M; i++) {
        cin >> a[i].first >> a[i].second;
    }

    // Sort by the right endpoint
    sort(a.begin(), a.end(),
         [](pair<int, int> x, pair<int, int> y) {
             return x.second < y.second;
         });

    int ans = 0;
    int last_cut = 0;

    for (auto [A, B] : a) {
        if (last_cut < A) {
            ans++;
            last_cut = B - 1;
        }
    }

    cout << ans << '\n';

    return 0;
}
