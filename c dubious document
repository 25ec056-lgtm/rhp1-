
#include <bits/stdc++.h>
using namespace std;

int main() {
    int N;
    cin >> N;

    vector<int> common(26, INT_MAX);

    for (int i = 0; i < N; i++) {
        string s;
        cin >> s;

        vector<int> cnt(26, 0);

        for (char ch : s) {
            cnt[ch - 'a']++;
        }

        for (int j = 0; j < 26; j++) {
            common[j] = min(common[j], cnt[j]);
        }
    }

    for (int j = 0; j < 26; j++) {
        for (int k = 0; k < common[j]; k++) {
            cout << char('a' + j);
        }
    }

    cout << '\n';

    return 0;
}
