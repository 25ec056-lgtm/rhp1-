
#include <bits/stdc++.h>
using namespace std;

const int K = 3;
const int INF = 1e9;

pair<int, int> getSegment(char c) {
    if (c == '0') return {K, K};
    if (c == '-') return {0, K - 1};
    return {K + 1, K * 2};
}

void solve() {
    int n;
    string s;
    cin >> n >> s;

    vector<vector<int>> dp(n + 1, vector<int>(2 * K + 1, INF));
    dp[0][K] = 0;

    for (int i = 0; i < n; i++) {
        auto [l, r] = getSegment(s[i]);

        for (int j = 0; j <= 2 * K; j++) {
            if (dp[i][j] == INF) continue;

            for (int k = l; k <= r; k++) {
                if (j == k) continue;

                dp[i + 1][k] = min(
                    dp[i + 1][k],
                    max(dp[i][j], abs(k - j))
                );
            }
        }
    }

    int ans = *min_element(dp[n].begin(), dp[n].end());

    cout << (ans == INF ? -1 : ans) << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--) {
        solve();
    }

    return 0;
}
